# Copie para .env e preencha. O .env nunca vai para o GitHub.

# ---- Banco PostgreSQL (Neon) ------------------------------------------------
# App: endereço com pooler. Migrations: conexão direta (sem pooler), em
# DATABASE_URL_UNPOOLED (a integração Neon da Vercel já cria as duas).
DATABASE_URL="postgresql://usuario:senha@host.neon.tech/neondb?sslmode=require"
DATABASE_URL_UNPOOLED=""
# Opcional. Com o banco local do "npx prisma dev", use o endereço do banco sombra dele.
SHADOW_DATABASE_URL=""

# ---- Conta de administrador criada pelo seed --------------------------------
# Sem ADMIN_PASSWORD, o seed gera uma senha provisória e mostra no terminal
# (na Vercel, no log do build); a troca é obrigatória no primeiro acesso.
ADMIN_NAME="Administrador MenuFácil"
ADMIN_EMAIL="admin@menufacil.app"
ADMIN_PASSWORD=""

# "true" cria dois restaurantes fictícios com cardápio, para testar.
SEED_DEMO="true"

# ---- Site ---------------------------------------------------------------------
# Endereço público (links nas mensagens). Na Vercel, sem isto, usa o domínio de produção.
APP_URL=""
# Fuso dos horários e do "hoje" nos painéis.
NEXT_PUBLIC_TIME_ZONE="America/Manaus"
# Contato da equipe na página /contato (opcionais).
CONTACT_EMAIL=""
CONTACT_WHATSAPP=""

# ---- Fotos ----------------------------------------------------------------------
# Vercel Blob: com o token, as fotos vão para lá. Sem token, no desenvolvimento
# ficam em public/uploads.
BLOB_READ_WRITE_TOKEN=""

# ---- WhatsApp (API oficial da Meta: WhatsApp Business Platform / Cloud API) ----
# "mock" (padrão) só registra as mensagens. "cloud_api" envia de verdade.
WHATSAPP_PROVIDER="mock"
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_API_VERSION="v23.0"
WHATSAPP_TEMPLATE_LANGUAGE="pt_BR"
# nomes dos modelos aprovados na Meta (se forem diferentes do padrão)
WHATSAPP_TEMPLATE_NEW_ORDER="novo_pedido"
WHATSAPP_TEMPLATE_PAYMENT="instrucoes_pix"
WHATSAPP_TEMPLATE_STATUS="status_pedido"
# webhook de status (entregue/lida): token de verificação e App Secret da Meta
WHATSAPP_VERIFY_TOKEN=""
WHATSAPP_APP_SECRET=""
# chave para criptografar o token do número próprio de cada restaurante (32 bytes em base64)
WHATSAPP_TOKEN_KEY=""
# protege /api/whatsapp/processar (reenvio da fila por cron)
CRON_SECRET=""
