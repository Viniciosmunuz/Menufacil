// MenuFácil: esquema do banco
//
// Multi-tenant por linha: tudo que pertence a um restaurante carrega
// restaurantId, e toda consulta do painel filtra por ele (ver src/server/auth).
// Valores em dinheiro sao guardados em centavos (Int), nunca em float.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// Usuarios, sessoes e permissoes
// ============================================================

enum UserRole {
  ADMIN // dono da plataforma: acesso a todos os restaurantes
  RESTAURANT_OWNER // acesso apenas aos restaurantes ligados a ele
}

enum UserStatus {
  ACTIVE
  DISABLED
}

model User {
  id                 String     @id @default(cuid())
  name               String
  email              String     @unique
  phone              String? // somente digitos, com DDI (preparado para login por WhatsApp)
  passwordHash       String
  role               UserRole
  status             UserStatus @default(ACTIVE)
  // obriga a trocar a senha no primeiro acesso (senha entregue pelo admin)
  mustChangePassword Boolean    @default(false)
  lastLoginAt        DateTime?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  sessions      Session[]
  ownerships    RestaurantOwner[]
  tokens        VerificationToken[]
  auditLogs     AuditLog[]
  statusChanges OrderStatusEvent[]
  pushDevices   PushDevice[]

  @@index([role])
}

// Sessao em banco: o cookie guarda um token aleatorio; aqui fica so o hash.
model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  userAgent String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum VerificationTokenType {
  PASSWORD_RESET
  LOGIN_CODE
  EMAIL_VERIFICATION
}

// Preparado para: recuperacao de senha, login por codigo e verificacao de e-mail.
model VerificationToken {
  id        String                @id @default(cuid())
  userId    String
  type      VerificationTokenType
  tokenHash String                @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime              @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
}

// ============================================================
// Restaurantes
// ============================================================

enum RestaurantStatus {
  DRAFT // em implantacao pelo admin: nao aparece no site
  PENDING_REVIEW // aguardando aprovacao do admin
  ACTIVE // publico
  INACTIVE // desativado: some do site, dados preservados
  BLOCKED // bloqueado pelo admin: some do site e o dono nao entra no painel
}

enum OpenMode {
  AUTO // segue o horario de funcionamento
  OPEN // aberto manualmente
  CLOSED // fechado manualmente
}

enum PixKeyType {
  CPF
  CNPJ
  EMAIL
  PHONE
  RANDOM
}

// Categorias da plataforma (Lanches, Pizzas, Bebidas...), gerenciadas pelo admin.
model PlatformCategory {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  icon      String? // nome do icone usado na interface
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  restaurants Restaurant[]
}

model Restaurant {
  id          String           @id @default(cuid())
  slug        String           @unique
  name        String
  description String?
  logoUrl     String?
  coverUrl    String?
  status      RestaurantStatus @default(DRAFT)
  featured    Boolean          @default(false)

  // contato
  whatsapp  String? // somente digitos, com DDI
  phone     String?
  email     String?
  instagram String?

  // endereco
  street       String?
  number       String?
  complement   String?
  neighborhood String?
  city         String?
  state        String?
  zipCode      String?

  // funcionamento
  openMode OpenMode @default(AUTO)

  // entrega e retirada
  deliveryEnabled  Boolean @default(true)
  pickupEnabled    Boolean @default(true)
  deliveryFeeCents Int     @default(0)
  minOrderCents    Int     @default(0)
  deliveryTimeMin  Int? // minutos
  deliveryTimeMax  Int?

  // pagamento
  pixKey              String?
  pixKeyType          PixKeyType?
  pixHolderName       String?
  paymentInstructions String?
  // pagamento na entrega/retirada (o Pix vale quando há chave cadastrada)
  acceptsCard         Boolean     @default(true)
  acceptsCash         Boolean     @default(true)

  // impressão: largura da bobina da térmica, 80 mm (padrão) ou 58 mm
  receiptWidth Int @default(80)

  // Recursos liberados pelo admin da plataforma, um a um. O que ja esta no
  // ar nasce ligado, para nenhum restaurante mudar de comportamento; o que
  // ainda esta sendo construido nasce desligado. O painel esconde o que
  // esta desligado e o servidor confere de novo, porque esconder o botao
  // nao impede ninguem de digitar o endereco na mao.
  printEnabled        Boolean @default(true)
  fullDeliveryEnabled Boolean @default(false)
  chatEnabled         Boolean @default(false)
  // totem de autoatendimento: modulo isolado, nasce desligado para todo mundo
  totemEnabled        Boolean @default(false)

  // avaliacao (preenchida no futuro por avaliacoes reais)
  ratingAverage Float?
  ratingCount   Int    @default(0)

  // Pizza: ate quantos sabores cabem numa pizza deste restaurante. 0 = nao
  // trabalha com pizza. Com 2, o cardapio ganha a pizza de 1 sabor e a de 2
  // sabores; com 4, vai ate a de 4 sabores.
  pizzaMaxFlavors Int @default(0)

  // numeracao das comandas: comeca em #1 a cada dia, como a comanda de
  // papel do balcao. "orderSeqDay" guarda o dia (no fuso da plataforma) a
  // que a contagem pertence; virou o dia, a proxima comanda volta para 1.
  orderSeq    Int     @default(0)
  orderSeqDay String?

  activatedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  categories          PlatformCategory[]
  owners              RestaurantOwner[]
  openingHours        OpeningHour[]
  menuCategories      MenuCategory[]
  products            Product[]
  orders              Order[]
  whatsappIntegration WhatsAppIntegration?
  messages            WhatsAppMessage[]
  auditLogs           AuditLog[]
  printDevices        PrintDevice[]
  pushDevices         PushDevice[]
  totemConfig         TotemConfig?
  totemDevices        TotemDevice[]
  totemPayments       TotemPayment[]

  @@index([status])
  @@index([city])
}

enum OwnerRole {
  OWNER
  STAFF // preparado para funcionarios no futuro
}

model RestaurantOwner {
  id           String    @id @default(cuid())
  restaurantId String
  userId       String
  role         OwnerRole @default(OWNER)
  createdAt    DateTime  @default(now())

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([restaurantId, userId])
  @@index([userId])
}

// Um intervalo por dia da semana (0 = domingo ... 6 = sabado).
model OpeningHour {
  id           String  @id @default(cuid())
  restaurantId String
  weekday      Int
  opensAt      String // "HH:MM"
  closesAt     String // "HH:MM" (pode passar da meia-noite: 18:00 as 02:00)
  closed       Boolean @default(false)

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([restaurantId, weekday])
}

// ============================================================
// Cardapio
// ============================================================

model MenuCategory {
  id           String   @id @default(cuid())
  restaurantId String
  name         String
  description  String?
  sortOrder    Int      @default(0)
  active       Boolean  @default(true)
  // catalogo de sabores de pizza (Especiais, Tradicionais): os produtos daqui
  // nao aparecem soltos no cardapio, sao os sabores que o cliente escolhe
  // dentro da pizza
  pizzaFlavors Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  products   Product[]

  @@index([restaurantId, sortOrder])
}

model Product {
  id              String   @id @default(cuid())
  restaurantId    String
  categoryId      String
  name            String
  description     String?
  imageUrl        String?
  priceCents      Int
  promoPriceCents Int?
  available       Boolean  @default(true)
  featured        Boolean  @default(false)
  sortOrder       Int      @default(0)
  // pizza montada: quantos sabores o cliente escolhe (1, 2, 3...). O preco e
  // o do sabor mais caro escolhido, nunca a soma nem a media.
  pizzaFlavors    Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  restaurant   Restaurant           @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  category     MenuCategory         @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  orderItems   OrderItem[]
  optionGroups ProductOptionGroup[]

  @@index([restaurantId, categoryId, sortOrder])
}

// Opções do produto (Tamanho, Sabor, Porção...). O preço de cada opção soma
// ao preço do produto; minSelect 0 = opcional, 1 ou mais = obrigatório.
model ProductOptionGroup {
  id               String  @id @default(cuid())
  productId        String
  name             String
  minSelect        Int     @default(1)
  maxSelect        Int     @default(1)
  sortOrder        Int     @default(0)
  // meio a meio (sabores de pizza): aceita 2 opções, cobrando a mais cara.
  // halfFromOptionId: opção de outro grupo (ex.: Tamanho "Pequena") a partir
  // da qual vale, na ordem do grupo; vazio = vale sempre
  halfHalf         Boolean @default(false)
  halfFromOptionId String?

  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  options ProductOption[]

  @@index([productId, sortOrder])
}

model ProductOption {
  id         String  @id @default(cuid())
  groupId    String
  name       String
  priceCents Int     @default(0)
  available  Boolean @default(true)
  sortOrder  Int     @default(0)

  group ProductOptionGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([groupId, sortOrder])
}

// ============================================================
// Clientes e pedidos
// ============================================================

// Cliente sem conta: identificado pelo WhatsApp.
model Customer {
  id        String   @id @default(cuid())
  name      String
  whatsapp  String   @unique // somente digitos, com DDI
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  addresses Address[]
  orders    Order[]
}

model Address {
  id           String   @id @default(cuid())
  customerId   String
  street       String
  number       String
  complement   String?
  neighborhood String
  reference    String?
  city         String?
  createdAt    DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  orders   Order[]

  @@index([customerId])
}

enum OrderType {
  DELIVERY
  PICKUP
}

// De onde o pedido veio. O que ja existia continua sendo WHATSAPP: e o
// fluxo do cardapio pelo link, que termina na conversa do WhatsApp.
enum OrderOrigin {
  WHATSAPP
  TOTEM // balcao, pago na maquininha do proprio totem
}

enum PaymentMethod {
  PIX
  CARD // na entrega (maquininha) ou no balcão, na retirada
  CASH
}

enum CardType {
  CREDIT
  DEBIT
}

enum OrderStatus {
  NEW
  AWAITING_PAYMENT
  PAYMENT_SENT
  CONFIRMED
  PREPARING
  READY
  OUT_FOR_DELIVERY
  COMPLETED
  CANCELED
}

model Order {
  id           String @id @default(cuid())
  restaurantId String
  number       Int // sequencial dentro do restaurante
  code         String @unique // codigo publico para o cliente acompanhar

  customerId           String
  // retrato do cliente e do endereco no momento do pedido
  customerName         String
  customerWhatsapp     String
  addressId            String?
  deliveryStreet       String?
  deliveryNumber       String?
  deliveryComplement   String?
  deliveryNeighborhood String?
  deliveryReference    String?

  type          OrderType
  origin        OrderOrigin   @default(WHATSAPP)
  /// Totem: comer no local (true) ou levar (false). Vazio em todo pedido que
  /// nao veio do totem -- no delivery quem responde isso e o "type".
  dineIn        Boolean?
  paymentMethod PaymentMethod
  status        OrderStatus   @default(NEW)
  notes         String?

  subtotalCents    Int
  deliveryFeeCents Int
  totalCents       Int

  /**
   * quando a comanda da cozinha saiu: evita a via sair duas vezes
   */
  printedAt      DateTime?
  /**
   * quando o recibo do cliente saiu (so pedido de totem tem).
   * E uma coluna a parte porque sao dois papeis diferentes, em duas
   * impressoras diferentes: a da cozinha e a do balcao do totem.
   */
  senhaPrintedAt DateTime?
  /**
   * quantas vezes o restaurante pediu a via de novo. O programa imprime
   * uma vez por tentativa: e por isso que pedir de novo funciona mesmo
   * com a via ja na lista do que ele imprimiu.
   */
  printRuns      Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  restaurant   Restaurant         @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  customer     Customer           @relation(fields: [customerId], references: [id])
  address      Address?           @relation(fields: [addressId], references: [id])
  items        OrderItem[]
  statusEvents OrderStatusEvent[]
  payment      Payment?
  messages     WhatsAppMessage[]

  // o numero repete de um dia para o outro (#1 todo dia), entao quem
  // identifica o pedido e o id e o code, nunca o numero
  @@index([restaurantId, number])
  @@index([restaurantId, status, createdAt])
  @@index([customerId])
}

model OrderItem {
  id             String  @id @default(cuid())
  orderId        String
  productId      String?
  // retrato do produto no momento do pedido
  productName    String
  unitPriceCents Int
  quantity       Int
  notes          String?
  // retrato das opções escolhidas: "Tamanho: Grande · Sabor: Calabresa"
  optionsText    String?
  totalCents     Int

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([orderId])
}

model OrderStatusEvent {
  id              String      @id @default(cuid())
  orderId         String
  status          OrderStatus
  note            String?
  changedByUserId String?
  createdAt       DateTime    @default(now())

  order     Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  changedBy User? @relation(fields: [changedByUserId], references: [id], onDelete: SetNull)

  @@index([orderId, createdAt])
}

enum PaymentStatus {
  PENDING // aguardando o cliente pagar
  PROOF_SENT // cliente diz que enviou o comprovante
  CONFIRMED // restaurante confirmou
  REFUNDED
  CANCELED
}

model Payment {
  id             String        @id @default(cuid())
  orderId        String        @unique
  method         PaymentMethod
  status         PaymentStatus @default(PENDING)
  amountCents    Int
  // retrato da chave Pix exibida ao cliente
  pixKey         String?
  pixKeyType     PixKeyType?
  // cartão: crédito ou débito; dinheiro: troco para quanto (vazio = não precisa)
  cardType       CardType?
  changeForCents Int?
  proofSentAt    DateTime?
  confirmedAt    DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

// ============================================================
// WhatsApp (API oficial da Meta)
// ============================================================

enum WhatsAppProvider {
  MOCK // desenvolvimento: registra a mensagem sem enviar
  CLOUD_API // WhatsApp Business Platform (Cloud API)
}

// Numero proprio do restaurante conectado a Cloud API (opcional, futuro).
// Sem isso, o envio usa o numero da plataforma configurado nas variaveis de ambiente.
model WhatsAppIntegration {
  id                   String           @id @default(cuid())
  restaurantId         String           @unique
  provider             WhatsAppProvider @default(MOCK)
  enabled              Boolean          @default(false)
  phoneNumberId        String?
  businessAccountId    String?
  displayPhone         String?
  // token criptografado no servidor (nunca vai para o navegador)
  accessTokenEncrypted String?
  notifyRestaurant     Boolean          @default(true)
  notifyCustomer       Boolean          @default(true)
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
}

enum WhatsAppMessageKind {
  ORDER_TO_RESTAURANT
  PAYMENT_INSTRUCTIONS
  ORDER_STATUS
}

enum WhatsAppMessageStatus {
  QUEUED
  SENDING
  SENT
  DELIVERED
  READ
  FAILED
}

// Fila de envio e registro do resultado: cada mensagem vira uma linha aqui
// antes de sair, e o resultado do provedor e gravado de volta.
model WhatsAppMessage {
  id                String                @id @default(cuid())
  restaurantId      String
  orderId           String?
  kind              WhatsAppMessageKind
  provider          WhatsAppProvider
  toPhone           String
  body              String
  templateName      String?
  templateParams    Json?
  status            WhatsAppMessageStatus @default(QUEUED)
  providerMessageId String?               @unique
  error             String?
  attempts          Int                   @default(0)
  nextAttemptAt     DateTime              @default(now())
  sentAt            DateTime?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  order      Order?     @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([status, nextAttemptAt])
  @@index([orderId])
}

// ============================================================
// Comercial e auditoria
// ============================================================

// "Quero cadastrar meu restaurante": vira um contato para o admin, nao um restaurante.
model RestaurantLead {
  id             String   @id @default(cuid())
  contactName    String
  restaurantName String
  whatsapp       String
  city           String?
  message        String?
  handled        Boolean  @default(false)
  createdAt      DateTime @default(now())
}

model AuditLog {
  id           String   @id @default(cuid())
  actorUserId  String?
  restaurantId String?
  action       String // ex.: "restaurant.update", "product.create", "order.status"
  details      Json?
  createdAt    DateTime @default(now())

  actor      User?       @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  restaurant Restaurant? @relation(fields: [restaurantId], references: [id], onDelete: SetNull)

  @@index([restaurantId, createdAt])
}

// Print Fácil: o programa instalado no computador do restaurante, que
// imprime os pedidos sozinho. Cada instalação vira um dispositivo aqui.
// Nasce sem restaurante, mostrando um código de pareamento; o dono digita
// esse código no painel e aí o dispositivo passa a receber os pedidos
// daquele restaurante, e só dele. Do token fica só o hash, como nas
// sessões: vazar a tabela não dá acesso a ninguém.
// O que esta impressora imprime. Um restaurante com totem tem duas: a da
// cozinha, no computador do balcao, e a do totem, que entrega o recibo na
// mao do cliente. Sem papel definido, as duas disputariam a mesma fila e a
// comanda sairia no lugar errado.
enum PrintRole {
  COMANDA // a via da cozinha, com o que preparar
  SENHA // o recibo do cliente: itens, valor, como pagou e a senha
}

model PrintDevice {
  id           String  @id @default(cuid())
  restaurantId String?

  /// o que sai nesta impressora; tudo que ja existia continua sendo comanda
  role PrintRole @default(COMANDA)

  /**
   * nome do computador, para o dono reconhecer no painel
   */
  name        String
  tokenHash   String  @unique
  /**
   * some depois do pareamento
   */
  pairingCode String? @unique

  /**
   * impressora escolhida no programa, só para mostrar no painel
   */
  printerName String?

  pairedAt   DateTime?
  lastSeenAt DateTime?
  createdAt  DateTime  @default(now())

  restaurant Restaurant? @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
}

// Celular (ou computador) que pediu para ser avisado quando entrar pedido
// novo. Quem guarda o aviso de verdade é o navegador: aqui fica so o
// endereco que o Google/Apple nos deu para entregar a mensagem, mais as
// duas chaves que embaralham o conteudo. Nada disso identifica a pessoa.
model PushDevice {
  id           String  @id @default(cuid())
  restaurantId String
  userId       String?

  /**
   * endereco do servico de push; e ele que identifica o aparelho
   */
  endpoint String @unique
  p256dh   String
  auth     String

  /**
   * "Android · Chrome", so para o dono reconhecer na lista
   */
  label String?

  createdAt DateTime  @default(now())
  lastOkAt  DateTime?
  /**
   * entregas seguidas que falharam; passando do limite, o aparelho sai
   */
  failures  Int       @default(0)

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  user       User?      @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([restaurantId])
}

// ============================================================
// Totem de autoatendimento
// ============================================================
// Modulo a parte: nada aqui e lido pelo fluxo de pedido do WhatsApp nem
// pelo Menu Facil para PC. O totem so existe para o restaurante com
// Restaurant.totemEnabled ligado pelo admin da plataforma.
//
// O dinheiro passa pela conta do proprio restaurante: cada um cadastra o
// Access Token e a maquininha Point dele. A plataforma nao intermedia
// pagamento nenhum.

model TotemConfig {
  id           String @id @default(cuid())
  restaurantId String @unique

  /**
   * Access Token do Mercado Pago do restaurante, criptografado com
   * AES-256-GCM (chave em TOTEM_TOKEN_KEY). Nunca volta para o navegador.
   */
  mpAccessToken String?
  /**
   * final do token em texto puro, so para o dono reconhecer qual esta salvo
   */
  mpTokenHint   String?
  /**
   * device_id da maquininha Point, como aparece na API do Mercado Pago
   */
  mpDeviceId    String?
  /**
   * segredo da assinatura das notificacoes, copiado do painel do Mercado
   * Pago. Criptografado do mesmo jeito que o token.
   */
  mpWebhookKey  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
}

// Cada totem instalado. Mesma ideia do PrintDevice: o aparelho guarda um
// token e aqui fica so o hash dele.
model TotemDevice {
  id           String  @id @default(cuid())
  restaurantId String?

  /**
   * nome do aparelho, para o dono reconhecer no painel ("Balcao 1")
   */
  name        String
  tokenHash   String  @unique
  /**
   * some depois do pareamento
   */
  pairingCode String? @unique

  /**
   * impressora termica escolhida no totem, so para mostrar no painel
   */
  printerName String?
  appVersion  String?

  pairedAt   DateTime?
  lastSeenAt DateTime?
  createdAt  DateTime  @default(now())

  restaurant Restaurant?    @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  payments   TotemPayment[]

  @@index([restaurantId])
}

// Como o cliente paga no totem. Dinheiro nao entra aqui: no balcao sem
// atendente nao ha quem receba nem quem de troco.
enum TotemPaymentMethod {
  CARD // cartao na maquininha Point do restaurante
  PIX // QR na tela do totem, pago pelo aplicativo do banco
}

enum TotemPaymentStatus {
  PENDING // esperando o cliente pagar
  APPROVED
  REJECTED
  CANCELED
  EXPIRED
}

// Uma passada de cartao no totem. Guardada aqui, e nao em Payment, porque
// Payment pertence ao pedido feito pelo WhatsApp e nao pode mudar de forma.
model TotemPayment {
  id           String  @id @default(cuid())
  restaurantId String
  deviceId     String?

  method      TotemPaymentMethod @default(CARD)
  /**
   * id da intencao de pagamento na API Point do Mercado Pago. So no
   * cartao: o Pix nao passa pela maquininha, nasce direto como pagamento.
   */
  intentId    String?            @unique
  /// external_reference mandado ao Mercado Pago: e por ele que o webhook
  /// acha esta linha quando o aviso chega
  reference   String?
  /**
   * id do pagamento no Mercado Pago. No cartao, chega quando a maquininha
   * aprova; no Pix, ja nasce com ele.
   */
  mpPaymentId String?
  /// pedido gravado depois que a maquininha aprovou; vazio ate la
  orderId     String?
  status      TotemPaymentStatus @default(PENDING)
  amountCents Int

  /**
   * o que o cliente escolheu, do jeito que o totem mandou: e com isso que
   * a via sai depois que o pagamento aprova
   */
  cart      Json?
  /**
   * ultimo aviso recebido do Mercado Pago, para conferir quando der errado
   */
  lastEvent Json?

  paidAt    DateTime?
  printedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  restaurant Restaurant   @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  device     TotemDevice? @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  @@index([restaurantId, createdAt])
  @@index([status])
  @@index([reference])
  @@index([mpPaymentId])
}
